# Bu dosya şablondur — GERÇEK değerleri .env'e yaz, .env asla commit edilmez.
# Depo public; buradaki hiçbir satır gerçek bir anahtar içermemeli.

# ---- Veritabanı (PC'de Docker) ----
POSTGRES_USER=cry
POSTGRES_PASSWORD=degistir-beni
POSTGRES_DB=cry
# Uygulama container'ından:
DATABASE_URL=postgresql://cry:degistir-beni@db:5432/cry?schema=public
# Host'tan (DBeaver vb.): postgresql://cry:...@127.0.0.1:15432/cry

# ---- Redis / kuyruk ----
REDIS_URL=redis://redis:6379

# ---- Oturum ----
# openssl rand -base64 32
AUTH_SECRET=
# İlk admin (seed script okur; ilk girişte değiştirme zorunlu)
SEED_ADMIN_USER=abidin
SEED_ADMIN_PASSWORD=

# ---- Zincir veri kaynakları ----
TRONGRID_API_KEY=
ETHERSCAN_API_KEY=
BLOCKSCOUT_API_KEY=

# ---- İzleme servisi (Hetzner) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WATCHER_DB_PATH=/data/watcher.sqlite
WATCHER_POLL_SECONDS=60

# ---- Fiyat ----
# TCMB kuru ücretsiz ve anahtarsız; ek bir fiyat kaynağı kullanılırsa buraya
