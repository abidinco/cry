// cry — veri modeli
//
// İki tasarım kuralı bütün şemaya yayılıyor:
//
// 1. TUTAR ham tam sayıdır (String olarak taşınan bigint). Float bir adli
//    raporda tutarı sessizce kaydırır; ondalığa çevirme gösterim sınırında.
// 2. Her ETİKET ve her ÇIKARIM kaynağını, güven skorunu ve doğrulama tarihini
//    taşır. Doğrulanmamış bir etiket rapora ya hiç girmez ya da açıkça
//    "doğrulanmamış" ibaresiyle girer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * ---------------- Kullanıcılar, roller, denetim ----------------
 */

model Role {
  id          Int      @id @default(autoincrement())
  key         String   @unique // "admin", "analist"
  name        String
  // İleride yeni rol tanımlanabilsin diye yetkiler veri; koda gömülmüyor.
  permissions Json     @default("[]")
  createdAt   DateTime @default(now()) @map("created_at")
  users       User[]

  @@map("roles")
}

model User {
  id                 Int       @id @default(autoincrement())
  username           String    @unique
  passwordHash       String    @map("password_hash")
  displayName        String?   @map("display_name")
  roleId             Int       @map("role_id")
  role               Role      @relation(fields: [roleId], references: [id])
  // Seed ile üretilen ilk şifre kullanılmaya devam edemez.
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now()) @map("created_at")
  lastLoginAt        DateTime? @map("last_login_at")

  cases     Case[]
  labels    Label[]    @relation("LabelCreator")
  approvals Label[]    @relation("LabelApprover")
  auditLogs AuditLog[]

  @@map("users")
}

/// Kim, ne zaman, hangi adresi sorguladı. Admin'e görünür.
model AuditLog {
  id        BigInt   @id @default(autoincrement())
  userId    Int?     @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String // search|trace|report|label.create|login
  target    String?
  meta      Json     @default("{}")
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

/**
 * ---------------- Zincir verisi: vaka odaklı artımlı indeks ----------------
 */

model Asset {
  id       Int     @id @default(autoincrement())
  chain    String
  /// Token'da sözleşme adresi; native varlıkta BOŞ DİZE.
  ///
  /// Neden null değil: Postgres'te NULL != NULL, yani nullable bir kolonla
  /// kurulan tekillik kısıtı native varlığı HİÇ korumaz — her tur yeni bir
  /// TRX satırı açılır ve hareketler farklı varlıklara dağılır.
  contract String  @default("")
  symbol   String
  decimals Int
  name     String?

  transfers Transfer[]
  prices    PriceDaily[]

  @@unique([chain, contract])
  @@index([chain, symbol])
  @@map("assets")
}

model Address {
  id      BigInt @id @default(autoincrement())
  chain   String
  /// Kanonik yazım: TRON base58, EVM küçük harf. Aynı cüzdan iki satır olmaz.
  address String

  firstSeen  DateTime? @map("first_seen")
  lastSeen   DateTime? @map("last_seen")
  balanceRaw String?   @map("balance_raw")
  isContract Boolean?  @default(false) @map("is_contract")

  /// Artımlı indeksin belleği: bir daha bu noktadan önceye sorulmaz.
  indexedThroughBlock Int?      @map("indexed_through_block")
  indexedThroughTs    DateTime? @map("indexed_through_ts")
  indexCursor         String?   @map("index_cursor")
  lastIndexedAt       DateTime? @map("last_indexed_at")
  /// "boş" ile "bakılmadı" ayrı sorulardır.
  indexState          String    @default("bilinmiyor") @map("index_state") // bilinmiyor|kismi|tam

  /// TRON: bu hesabı kim aktive etti (aynı kişi kümelemesinin dayanağı).
  activatedByAddress String?   @map("activated_by_address")
  activatedAt        DateTime? @map("activated_at")
  activationTxHash   String?   @map("activation_tx_hash")

  labels       Label[]
  watches      Watch[]
  outTransfers Transfer[] @relation("TransferFrom")
  inTransfers  Transfer[] @relation("TransferTo")

  @@unique([chain, address])
  @@index([chain, activatedByAddress])
  @@map("addresses")
}

/// Değer hareketinin atomu. Motorun gördüğü tek şey budur.
model Transfer {
  id          BigInt   @id @default(autoincrement())
  chain       String
  txHash      String   @map("tx_hash")
  /// Aynı tx içindeki sıra — bir tx birden çok hareket taşıyabilir.
  index       Int
  blockNumber Int?     @map("block_number")
  ts          DateTime

  fromAddressId BigInt?  @map("from_address_id")
  fromAddress   Address? @relation("TransferFrom", fields: [fromAddressId], references: [id])
  toAddressId   BigInt?  @map("to_address_id")
  toAddress     Address? @relation("TransferTo", fields: [toAddressId], references: [id])

  assetId   Int     @map("asset_id")
  asset     Asset   @relation(fields: [assetId], references: [id])
  /// Ham tam sayı. Numeric değil String: 2^63 üstü token tutarları var.
  amountRaw String  @map("amount_raw")
  kind      String // native|token|internal|utxo
  success   Boolean @default(true)
  feeRaw    String? @map("fee_raw")
  raw       Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([chain, txHash, index])
  @@index([fromAddressId, ts])
  @@index([toAddressId, ts])
  @@index([chain, ts])
  @@map("transfers")
}

/// Formattan çözülemeyen girdilerin yoklama sonucu.
model ProbeCache {
  id       BigInt   @id @default(autoincrement())
  input    String   @unique
  kind     String // address|tx
  result   Json
  probedAt DateTime @default(now()) @map("probed_at")

  @@map("probe_cache")
}

/**
 * ---------------- Etiketler ve borsa tespiti ----------------
 */

model Label {
  id        Int     @id @default(autoincrement())
  chain     String
  addressId BigInt  @map("address_id")
  address   Address @relation(fields: [addressId], references: [id], onDelete: Cascade)

  title       String
  description String?
  category    String // exchange_hot|exchange_deposit|mixer|sanction|bridge|contract|kullanici|diger
  /// Kategori exchange_* ise dolu: "Binance", "BtcTurk"…
  exchange    String?

  /// Etiket NEREDEN geldi: tronscan|ofac|acik_kaynak|kesif|kullanici
  source     String
  sourceUrl  String?   @map("source_url")
  /// 0..1. Keşif motorunun ürettiği etikette hesaplanmış değer durur.
  confidence Float     @default(0)
  /// Doğrulanmamış etiket rapora "doğrulanmamış" ibaresiyle girer.
  verifiedAt DateTime? @map("verified_at")
  verifiedBy String?   @map("verified_by")

  visibility   String    @default("private") // private|public
  /// Public etiket admin onayı ister; başlangıçta hepsi onaydan geçer.
  approvedAt   DateTime? @map("approved_at")
  approvedById Int?      @map("approved_by_id")
  approvedBy   User?     @relation("LabelApprover", fields: [approvedById], references: [id])

  createdById Int?     @map("created_by_id")
  createdBy   User?    @relation("LabelCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  evidence    Json     @default("{}")

  @@index([addressId])
  @@index([category, exchange])
  @@map("labels")
}

/// Deposit sezgiselinin çıktısı: A → D, D → bilinen borsa hot wallet'ı.
model DepositCandidate {
  id               BigInt    @id @default(autoincrement())
  chain            String
  depositAddress   String    @map("deposit_address")
  hotWalletAddress String    @map("hot_wallet_address")
  exchange         String?
  /// Kaç süpürme, toplam tutar, ilk/son tarih — kanıt burada.
  evidence         Json      @default("{}")
  confidence       Float     @default(0)
  status           String    @default("aday") // aday|onaylandi|reddedildi
  reviewedById     Int?      @map("reviewed_by_id")
  reviewedAt       DateTime? @map("reviewed_at")
  detectedAt       DateTime  @default(now()) @map("detected_at")

  @@unique([chain, depositAddress, hotWalletAddress])
  @@index([exchange, status])
  @@map("deposit_candidates")
}

/**
 * ---------------- Vakalar ----------------
 */

model Case {
  id          Int       @id @default(autoincrement())
  slug        String    @unique
  title       String
  description String?
  ownerId     Int       @map("owner_id")
  owner       User      @relation(fields: [ownerId], references: [id])
  /// Varsayılan private; public yapmak admin onayı ister.
  visibility  String    @default("private")
  approvedAt  DateTime? @map("approved_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  notes     CaseNote[]
  queries   CaseQuery[]
  traceRuns TraceRun[]
  reports   Report[]
  watches   Watch[]

  @@map("cases")
}

model CaseNote {
  id        Int      @id @default(autoincrement())
  caseId    Int      @map("case_id")
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  body      String
  authorId  Int?     @map("author_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([caseId, createdAt])
  @@map("case_notes")
}

/// Vaka içi arama geçmişi — ileri/geri gezinme çubuğunu bu besler.
model CaseQuery {
  id        BigInt   @id @default(autoincrement())
  caseId    Int      @map("case_id")
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  rawInput  String   @map("raw_input")
  /// detectNetwork() çıktısı — "neden TRON dedin" cevabı burada durur.
  detection Json
  chain     String?
  resolved  String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([caseId, createdAt])
  @@map("case_queries")
}

/**
 * ---------------- Takip koşusu ve dondurulmuş graf ----------------
 */

model TraceRun {
  id     BigInt @id @default(autoincrement())
  caseId Int    @map("case_id")
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  chain       String
  rootAddress String @map("root_address")
  direction   String @default("ileri") // ileri|geri
  /// Seçilen kural rapora METODOLOJİ olarak yazılır.
  taintRule   String @map("taint_rule") // fifo|orantisal|zaman_pencereli
  params      Json   @default("{}") // hop bütçesi, min tutar, dallanma eşiği…

  status     String    @default("kuyrukta") // kuyrukta|calisiyor|bitti|durduruldu|hata
  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")
  /// Neden durdu: butce|dallanma|esik|terminal|dugum_siniri
  stopReason String?   @map("stop_reason")
  stats      Json      @default("{}")

  nodes   TraceNode[]
  edges   TraceEdge[]
  reports Report[]

  @@index([caseId, startedAt])
  @@map("trace_runs")
}

model TraceNode {
  id         BigInt   @id @default(autoincrement())
  traceRunId BigInt   @map("trace_run_id")
  traceRun   TraceRun @relation(fields: [traceRunId], references: [id], onDelete: Cascade)

  chain          String
  address        String
  hop            Int
  /// Bu düğüme atfedilen pay (0..1) — seçilen taint kuralının çıktısı.
  taintShare     Float   @default(0) @map("taint_share")
  amountRaw      String? @map("amount_raw")
  isTerminal     Boolean @default(false) @map("is_terminal")
  terminalReason String? @map("terminal_reason")
  /// Düğüm anındaki etiket görüntüsü — rapor donduğunda değişmemeli.
  labelSnapshot  Json    @default("{}") @map("label_snapshot")

  @@unique([traceRunId, chain, address])
  @@index([traceRunId, hop])
  @@map("trace_nodes")
}

model TraceEdge {
  id         BigInt   @id @default(autoincrement())
  traceRunId BigInt   @map("trace_run_id")
  traceRun   TraceRun @relation(fields: [traceRunId], references: [id], onDelete: Cascade)

  chain         String
  txHash        String   @map("tx_hash")
  txIndex       Int      @map("tx_index")
  fromAddress   String   @map("from_address")
  toAddress     String   @map("to_address")
  assetSymbol   String   @map("asset_symbol")
  assetContract String?  @map("asset_contract")
  decimals      Int
  amountRaw     String   @map("amount_raw")
  ts            DateTime
  hop           Int
  taintShare    Float    @default(0) @map("taint_share")

  @@index([traceRunId, hop])
  @@index([traceRunId, ts])
  @@map("trace_edges")
}

/// Kanıt bütünlüğü: rapor alındığında graf DONDURULUR ve saklanır.
model Report {
  id         BigInt    @id @default(autoincrement())
  caseId     Int       @map("case_id")
  case       Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  traceRunId BigInt?   @map("trace_run_id")
  traceRun   TraceRun? @relation(fields: [traceRunId], references: [id])

  title    String
  /// Dondurulmuş graf + kullanılan fiyatlar + metodoloji. Yeniden üretilebilir.
  snapshot Json
  columns  Json   @default("[]")
  /// PDF'e basılan SHA-256 özeti.
  sha256   String

  createdById Int?     @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([caseId, createdAt])
  @@map("reports")
}

/**
 * ---------------- Fiyat ve kur ----------------
 */

/// Günlük kapanış yeterli; saniye hassasiyeti ücretli ve gerekmiyor.
model PriceDaily {
  id        BigInt   @id @default(autoincrement())
  assetId   Int      @map("asset_id")
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  usd       Decimal  @db.Decimal(38, 12)
  source    String
  /// Kullanıcı elle girdiyse rapor bunu ayırt etmeli.
  manual    Boolean  @default(false)
  fetchedAt DateTime @default(now()) @map("fetched_at")

  @@unique([assetId, date])
  @@map("prices_daily")
}

/// USD/TRY — TCMB'nin ücretsiz XML servisi; resmi kur raporda daha sağlam.
model FxRateDaily {
  date      DateTime @id @db.Date
  usdTry    Decimal  @map("usd_try") @db.Decimal(18, 6)
  source    String   @default("tcmb")
  fetchedAt DateTime @default(now()) @map("fetched_at")

  @@map("fx_rates_daily")
}

/**
 * ---------------- İzleme ve uyarılar ----------------
 */

/// Takip listesi. 7/24 izleme Hetzner'da SQLite ile döner; bu tablo ANA
/// kayıttır, sunucudaki servis buradan senkronlanır.
model Watch {
  id        Int     @id @default(autoincrement())
  chain     String
  addressId BigInt  @map("address_id")
  address   Address @relation(fields: [addressId], references: [id], onDelete: Cascade)
  caseId    Int?    @map("case_id")
  case      Case?   @relation(fields: [caseId], references: [id], onDelete: SetNull)

  label          String?
  active         Boolean   @default(true)
  /// Servisin en son gördüğü işlem — aynı hareket iki kez bildirilmesin.
  lastSeenTxHash String?   @map("last_seen_tx_hash")
  lastCheckedAt  DateTime? @map("last_checked_at")
  createdById    Int?      @map("created_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")

  alerts Alert[]

  @@unique([chain, addressId])
  @@map("watches")
}

model Alert {
  id      BigInt @id @default(autoincrement())
  watchId Int    @map("watch_id")
  watch   Watch  @relation(fields: [watchId], references: [id], onDelete: Cascade)

  txHash      String    @map("tx_hash")
  ts          DateTime
  amountRaw   String?   @map("amount_raw")
  assetSymbol String?   @map("asset_symbol")
  direction   String? // gelen|giden
  sentAt      DateTime? @map("sent_at")
  channel     String    @default("telegram")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([watchId, txHash])
  @@index([watchId, createdAt])
  @@map("alerts")
}
